# Port (most hosts set this automatically — you usually don't need to touch it)
PORT=3000

# ---- Admin access (Booking admin panel + Expense Tracker) ----
# Any long random string. You enter this once in the browser (it's saved locally)
# to unlock the booking admin panel and the expense tracker. Without this set,
# both stay locked to everyone, including you.
ADMIN_KEY=change-this-to-a-long-random-string

# ---- LinkHub (/linkhub) ----
# MongoDB connection string (use MongoDB Atlas free tier: https://www.mongodb.com/atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/khang
# Any long random string — used to sign login sessions
SESSION_SECRET=change-this-to-a-long-random-string

# ---- Inkling (/tools/inkling) — AI writing assistant ----
# You only need to fill in the provider(s) you actually want to offer.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
# Optional: override default models
# GEMINI_MODEL=gemini-2.0-flash
# DEEPSEEK_MODEL=deepseek-chat
# GROQ_MODEL=llama-3.3-70b-versatile
